# =====================================================================
# Secrets & generated config - NEVER commit (D15: recursive patterns)
# 密钥与生成配置 —— 任何目录下都不得提交
#
# A subscription URL is a credential.  These patterns must catch it no
# matter where an operator or a script drops the file (repo root,
# install_dir/, config/, linux sandbox roots, ...).
# =====================================================================
**/subscription.env
**/subscription.env.local
**/*.env
!**/*.env.example
**/controller.secret

# Rendered mihomo configs contain the controller secret + provider URLs.
**/config.yaml
!config/config.yaml.template
install_dir/config.yaml

# =====================================================================
# Downloaded binaries & runtime data (Windows install_dir + repo root)
# 运行时下载的二进制、Geo 数据与状态
# =====================================================================
install_dir/mihomo.exe
install_dir/mihomo-windows-amd64.exe
install_dir/wintun.dll
install_dir/*.dat
install_dir/cache.db
install_dir/**/*.db
install_dir/logs/
install_dir/*.log
install_dir/**/*.log
install_dir/stderr.log
install_dir/stdout.log

# Provider snapshots fetched from subscription URLs (contain node creds).
# The directory itself stays tracked via .gitkeep.
providers/*.yaml
providers/*.yml
!providers/.gitkeep
install_dir/providers/*.yaml
install_dir/providers/*.yml
!install_dir/providers/.gitkeep

# Linux side artifacts (staging roots, caches, build/test droppings).
linux/.mpm-root/
linux/**/__pycache__/
*.py[cod]
.pytest_cache/
.coverage

# =====================================================================
# Editor / OS droppings (cross-platform, incl. Windows)
# =====================================================================
profile.ps1
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*.tmp
