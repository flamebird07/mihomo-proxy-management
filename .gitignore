# 用户本地配置（含订阅 URL）—— 切勿提交
# User-local config (contains subscription URL) - NEVER commit
# 任何位置的 subscription.env / *.env.local（兜底，防止误提交）
subscription.env
*.env
*.env.local
config/subscription.env
install_dir/subscription.env
*.env.local

# 由 install.ps1 生成的运行配置
# Generated by install.ps1 at install time
install_dir/config.yaml
config/config.yaml

# 二进制 / Geo 数据（运行时下载）
# Binaries & geo data (downloaded at install time)
install_dir/mihomo.exe
install_dir/mihomo-windows-amd64.exe
install_dir/wintun.dll
install_dir/GeoIP.dat
install_dir/GeoSite.dat
install_dir/cache.db

# 运行时状态
# Runtime state
install_dir/logs/
install_dir/*.log
install_dir/stderr.log
install_dir/stdout.log
install_dir/providers/*.yaml
!install_dir/providers/.gitkeep

# PowerShell
# PSReadLine history (may contain sensitive input)
profile.ps1

# Windows
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# IDE / 编辑器
.vscode/
.idea/
*.swp
*.swo

# OS 杂项
.DS_Store
*.tmp