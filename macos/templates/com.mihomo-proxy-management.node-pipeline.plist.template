<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>__LABEL__</string>
	<key>ProgramArguments</key>
	<array>
		<string>__PYTHON__</string>
		<string>-m</string>
		<string>mpm_macos.node_pipeline</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PYTHONPATH</key>
		<string>__PACKAGE_DIR__</string>
		<key>PYTHONUNBUFFERED</key>
		<string>1</string>
	</dict>
	<!-- Node pipeline: collect -> probe/gate -> valid-node provider -> stable
	     GPT switch, one tick per interval.  No RunAtLoad and no KeepAlive for
	     the same reasons as the feishu-sync job: the first tick fires one
	     interval after load, failures wait for the next interval, and launchd
	     skips ticks while a run is still going. -->
	<key>StartInterval</key>
	<integer>__SYNC_INTERVAL__</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>WorkingDirectory</key>
	<string>__MIHOMO_HOME__</string>
	<key>StandardOutPath</key>
	<string>__LOG_OUT__</string>
	<key>StandardErrorPath</key>
	<string>__LOG_ERR__</string>
</dict>
</plist>
