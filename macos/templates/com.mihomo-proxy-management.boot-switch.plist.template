<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>__LABEL__</string>
	<key>ProgramArguments</key>
	<array>
		<string>__PYTHON__</string>
		<string>-m</string>
		<string>mpm_macos.boot</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PYTHONPATH</key>
		<string>__PACKAGE_DIR__</string>
		<key>PYTHONUNBUFFERED</key>
		<string>1</string>
	</dict>
	<!-- Runs once at boot; no KeepAlive on purpose (a failing switch must not
	     be retried every few seconds and flap the network). -->
	<key>RunAtLoad</key>
	<true/>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>WorkingDirectory</key>
	<string>__MIHOMO_HOME__</string>
	<key>StandardOutPath</key>
	<string>__LOG_OUT__</string>
	<key>StandardErrorPath</key>
	<string>__LOG_ERR__</string>
</dict>
</plist>
