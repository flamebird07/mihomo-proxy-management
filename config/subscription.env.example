# Mihomo 订阅与本地参数
# Mihomo subscription & local settings.
#
# 复制为 subscription.env 后填入你自己的值
# Copy this file to subscription.env and fill in your own values.

# 你的 YAML 订阅链接（机场 / 自建，需返回 mihomo 兼容格式）
# Your YAML subscription URL (provider / self-hosted, must return mihomo-compatible YAML)
# 注意：本文件是模板；真实链接是凭据，只能保存在本地 subscription.env（已 gitignore）。
# The real link is a credential - keep it only in the local, gitignored subscription.env.
SUBSCRIPTION_URL=https://provider.example.invalid/link/your-token?clash=1

# 三源候选池入口专用；与旧安装入口独立，不自动修改运行配置。
# 三个槽位都参与统计；缺失/失败的槽位会导致非零退出。
SUBSCRIPTION_URL_1=
SUBSCRIPTION_URL_2=
SUBSCRIPTION_URL_3=
SUBSCRIPTION_UA_1=ClashMeta/1.18.0
SUBSCRIPTION_UA_2=ClashMeta/1.18.0
SUBSCRIPTION_UA_3=ClashMeta/1.18.0

# 各订阅源官网/面板页面（公开网址，非订阅 token）。用于表1「页面可达」探测。
# Public landing/panel page per source (NOT the subscription token URL).
# 留空 = 表1 记「未配置」。探测走本地混合代理 127.0.0.1:7890。
SOURCE_PAGE_URL_1=
SOURCE_PAGE_URL_2=
SOURCE_PAGE_URL_3=

# 去重后的最少候选数，默认 1，只防止空池；建议按已知规模提高。
# 不达标不替换输出。可用 --min-nodes / -MinNodes 覆盖；不允许 0。
MIN_CANDIDATE_NODES=1

# 订阅刷新间隔（分钟），0 = 仅启动时拉一次
# Subscription refresh interval (minutes). 0 = fetch once on startup.
SUBSCRIPTION_INTERVAL=60

# Dashboard 密码（留空 = 无密码，强烈建议设置）
# Dashboard password. Leave empty = no password (NOT recommended).
SECRET=change-me-to-a-random-string

# 安装目录（install.ps1 会自动检测；如需手动覆盖修改这里）
# Install directory (auto-detected by install.ps1; override here if needed)
INSTALL_DIR=C:\mihomo
