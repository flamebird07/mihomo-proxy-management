# =====================================================================
# Mihomo (Clash.Meta) 配置模板 - 由 install.ps1 替换占位符后生成
# Config template - run scripts\install.ps1 to generate the real config.
#
# 占位符 / Placeholders:
#   __SUBSCRIPTION_URL__       你的 YAML 订阅地址
#   __SUBSCRIPTION_INTERVAL__  订阅刷新间隔（分钟，0=仅启动拉一次）
#   __SECRET__                 Dashboard 密码（留空 = 无密码）
#
# 本模板是 Windows / macOS 共用的生产策略单一来源。
# 模板中不得出现真实节点名、订阅地址或密钥：所有组成员都通过
# proxy-provider 的 use + filter（或区域子组）获得。
# =====================================================================

mode: rule

external-controller: 127.0.0.1:9090
secret: "__SECRET__"

mixed-port: 7890
allow-lan: false
bind-address: 127.0.0.1

ipv6: false
log-level: info

# ---------- DNS ----------
dns:
  enable: true
  listen: 127.0.0.1:1053
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - '*.lan'
    - '*.local'
    - +.localhost
    - +.msftconnecttest.com
    - +.msftncsi.com
  default-nameserver:
    - 223.5.5.5
  nameserver:
    - 223.5.5.5
  proxy-server-nameserver:
    - 223.5.5.5
  fallback:
    - 8.8.8.8
  fallback-filter:
    geoip: true
    geoip-code: CN
    geosite:
      - gfw

# ---------- Geo data ----------
geodata-mode: true
geo-auto-update: true
geo-update-interval: 24

profile:
  store-selected: true
  store-fake-ip: true

unified-delay: true
tcp-concurrent: true
sniffing: true

# ---------- TUN ----------
tun:
  enable: true
  stack: gvisor
  auto-route: true
  auto-detect-interface: true
  dns-hijack:
    - any:53
    - tcp://any:53
  sniffing: true

# =====================================================================
# Proxy providers
# =====================================================================
proxy-providers:
  subscription:
    type: http
    url: "__SUBSCRIPTION_URL__"
    path: ./providers/subscription.yaml
    interval: __SUBSCRIPTION_INTERVAL__
    health-check:
      enable: true
      url: https://www.gstatic.com/generate_204
      interval: 300
      timeout: 5000

# =====================================================================
# Proxy groups
#
# 区域子组只通过 filter 从订阅里挑节点，模板本身不含任何节点名。
# 组顺序 = 生产候选顺序（fallback 按列表顺序选第一个可用项）。
# =====================================================================
proxy-groups:
  - name: PROXY
    type: select
    use:
      - subscription
    proxies:
      - AUTO-FOREIGN
      - US-FAST
      - DIRECT

  - name: AUTO-FOREIGN
    type: url-test
    use:
      - subscription
    url: https://www.gstatic.com/generate_204
    interval: 300
    tolerance: 100
    timeout: 5000

  # ---- CURSOR: 美国优先，日本兜底（无 DIRECT） ----
  - name: CURSOR-US
    type: fallback
    use:
      - subscription
    filter: '(?i)美国|美國|\bUS\b|USA|United States|🇺🇸'
    url: https://cursor.com/
    interval: 180
    timeout: 8000
    lazy: false

  - name: CURSOR-JP
    type: fallback
    use:
      - subscription
    filter: '(?i)日本|\bJP\b|Japan|🇯🇵'
    url: https://cursor.com/
    interval: 180
    timeout: 8000
    lazy: false

  - name: CURSOR
    type: fallback
    proxies:
      - CURSOR-US
      - CURSOR-JP
    url: https://cursor.com/
    interval: 180
    timeout: 8000
    lazy: false

  # ---- CODEBUDDY: DIRECT 首位，其后 香港→台湾→新加坡→日本 ----
  - name: CODEBUDDY-HK
    type: fallback
    use:
      - subscription
    filter: '(?i)香港|\bHK\b|Hong ?Kong|🇭🇰'
    url: https://www.codebuddy.ai/
    interval: 60
    timeout: 5000

  - name: CODEBUDDY-TW
    type: fallback
    use:
      - subscription
    filter: '(?i)台湾|台灣|\bTW\b|Taiwan|🇹🇼'
    url: https://www.codebuddy.ai/
    interval: 60
    timeout: 5000

  - name: CODEBUDDY-SG
    type: fallback
    use:
      - subscription
    filter: '(?i)新加坡|\bSG\b|Singapore|🇸🇬'
    url: https://www.codebuddy.ai/
    interval: 60
    timeout: 5000

  - name: CODEBUDDY-JP
    type: fallback
    use:
      - subscription
    filter: '(?i)日本|\bJP\b|Japan|🇯🇵'
    url: https://www.codebuddy.ai/
    interval: 60
    timeout: 5000

  - name: CODEBUDDY
    type: fallback
    proxies:
      - DIRECT
      - CODEBUDDY-HK
      - CODEBUDDY-TW
      - CODEBUDDY-SG
      - CODEBUDDY-JP
    url: https://www.codebuddy.ai/
    interval: 60
    timeout: 5000

  - name: US-FAST
    type: url-test
    use:
      - subscription
    filter: "(?i)美|us|usa|🇺🇸"
    url: https://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50
    timeout: 5000

  - name: VIETNAM
    type: select
    use:
      - subscription
    filter: "(?i)越南|vietnam|🇻🇳"
    proxies:
      - PROXY
      - DIRECT

  - name: GLOBAL
    type: select
    proxies:
      - PROXY
      - AUTO-FOREIGN
      - CODEBUDDY
      - US-FAST
      - VIETNAM
      - DIRECT

# =====================================================================
# Rules
# 顺序即语义（mihomo 命中第一条即停）：不要重排。
# =====================================================================
rules:
  # 生产首条：火山引擎 Ark API 必须直连
  - DOMAIN,ark.cn-beijing.volces.com,DIRECT

  - DOMAIN-SUFFIX,superboss.cc,DIRECT
  - GEOSITE,private,DIRECT
  - GEOIP,private,DIRECT,no-resolve

  # 海外开发 / AI 服务
  - GEOSITE,openai,US-FAST
  - GEOSITE,anthropic,US-FAST
  - GEOSITE,github,US-FAST
  - GEOSITE,google,PROXY
  - DOMAIN-SUFFIX,x.ai,US-FAST
  - DOMAIN-SUFFIX,grok.com,US-FAST
  - DOMAIN-SUFFIX,chatgpt.com,US-FAST

  # Cursor 五域
  - DOMAIN-SUFFIX,cursor.com,CURSOR
  - DOMAIN-SUFFIX,cursor.sh,CURSOR
  - DOMAIN-SUFFIX,cursorapi.com,CURSOR
  - DOMAIN-SUFFIX,cursor-auth.com,CURSOR
  - DOMAIN-SUFFIX,cursorvm.com,CURSOR

  # TikTok（jinritemai 的 DIRECT 必须排在 GEOSITE,tiktok 之前）
  - DOMAIN-SUFFIX,jinritemai.com,DIRECT
  - GEOSITE,tiktok,VIETNAM
  - DOMAIN-SUFFIX,tiktok.com,VIETNAM
  - DOMAIN-SUFFIX,tiktokv.com,VIETNAM

  # CodeBuddy 专组 / 订阅边缘 IP（与生产配置同步）
  - DOMAIN-SUFFIX,codebuddy.ai,CODEBUDDY
  - IP-CIDR,104.21.95.252/32,AUTO-FOREIGN,no-resolve
  - IP-CIDR,172.67.171.232/32,AUTO-FOREIGN,no-resolve
  - IP-CIDR,46.82.174.69/32,AUTO-FOREIGN,no-resolve
  - IP-CIDR,8.7.198.46/32,AUTO-FOREIGN,no-resolve
  - IP-CIDR,43.207.232.3/32,AUTO-FOREIGN,no-resolve

  # 国内
  - GEOSITE,cn,DIRECT
  - GEOIP,cn,DIRECT,no-resolve

  - MATCH,PROXY
