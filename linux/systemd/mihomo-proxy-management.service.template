# mihomo-proxy-management.service - TEMPLATE
#
# This is a NON-SECRET reference copy of what the installer renders.  The real
# unit is produced by mpm/unit.py at install time (paths depend on the profile
# and on whether TUN is available), so do not edit this file expecting a change
# on a deployed host; run `mihomo-proxy-management install` again instead.
#
# Placeholders substituted by mpm/unit.py:
#   {BINARY}        /usr/libexec/mihomo-proxy-management/current/mihomo
#   {STATE_DIR}     /var/lib/mihomo-proxy-management   (== WorkingDirectory)
#   {RUN_NAME}      mihomo-proxy-management            (RuntimeDirectory)
#   {CLI}           /usr/local/bin/mihomo-proxy-management
#   {CAPABILITIES}  TUN profile only: CAP_NET_ADMIN + CAP_NET_RAW
#
# ExecStart carries NO url, NO token and NO Environment= line: the subscription
# lives only inside the 0600 config.yaml in {STATE_DIR}.

[Unit]
Description=mihomo-proxy-management (mihomo TUN profile)
Documentation=https://github.com/flamebird07/mihomo-proxy-management
After=network-online.target
Wants=network-online.target
# StartLimit* are [Unit] keys since systemd 229 (ignored in [Service])
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# the installed CLI wrapper is itself executable (#!/bin/sh, 0755) and picks its
# own interpreter; never prefix it with python3 (that parses a shell script as
# Python and the service can never start)
ExecStartPre={CLI} configure --check-only --quiet
WorkingDirectory={STATE_DIR}
ExecStart={BINARY} -d {STATE_DIR}

Restart=on-failure
RestartSec=5s
KillMode=control-group
TimeoutStopSec=30s

UMask=0077
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
# PrivateDevices / PrivateUsers are deliberately NOT enabled: they would hide
# /dev/net/tun and remap the root-owned state directory.
{CAPABILITIES}
RuntimeDirectory={RUN_NAME}
RuntimeDirectoryMode=0700
SyslogLevel=info

[Install]
WantedBy=multi-user.target
